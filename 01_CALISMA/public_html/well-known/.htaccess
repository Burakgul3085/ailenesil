RewriteEngine on
ErrorDocument 404 /404.html

# --- SITEMAP ---
RewriteRule ^(en|ar)/sitemap\.xml$ sitemap.php?lang=$1 [NC,L]
RewriteRule ^sitemap\.xml$ sitemap.php [NC,L]

